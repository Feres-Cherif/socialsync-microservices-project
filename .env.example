# Local demonstration defaults. Copy to .env and replace ALL passwords before deployment.
# Use URL-safe alphanumeric passwords: these are interpolated into database URLs.
POSTGRES_DB=socialsync
POSTGRES_USER=postgres
POSTGRES_PASSWORD=socialsync-local-db
POST_DB_PASSWORD=socialsync-local-post
MEDIA_DB_PASSWORD=socialsync-local-media
ADMIN_USER=admin
ADMIN_PASSWORD=socialsync-local-admin
JWT_SECRET=socialsync-local-jwt-secret-change-before-deployment
INTERNAL_API_KEY=socialsync-local-internal-key
FRONTEND_PORT=8080
MAX_UPLOAD_MB=200
# Cover used by ffmpeg for MP3-to-MP4 conversion inside the media image.
DEFAULT_COVER=/app/default_cover.png
LOG_LEVEL=INFO

# Global simulation defaults to true. An empty per-platform value inherits DRY_RUN.
DRY_RUN=true
LINKEDIN_DRY_RUN=
FACEBOOK_DRY_RUN=
INSTAGRAM_DRY_RUN=
YOUTUBE_DRY_RUN=

# Only needed for real publishing. Never commit real credentials.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
LINKEDIN_API_VERSION=202610
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
META_API_VERSION=v22.0
# Public HTTPS endpoint ending in /api/media; Meta must be able to fetch files.
PUBLIC_MEDIA_BASE_URL=
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_PRIVACY_STATUS=private

# Service-level variables assigned by Compose: DATABASE_URL, REDIS_URL,
# MEDIA_SERVICE_URL, POST_SERVICE_URL, MEDIA_DIR, RUN_MIGRATIONS, DEFAULT_COVER.
